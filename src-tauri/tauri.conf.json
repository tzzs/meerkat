{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.0",
  "identifier": "com.tzz.pulse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "url": "index.html"
      },
      {
        "label": "panel",
        "title": "Pulse Panel",
        "width": 400,
        "height": 580,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "url": "panel.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TZZ",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
