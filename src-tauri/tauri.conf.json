{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meerkat",
  "version": "0.3.0",
  "identifier": "com.tzz.meerkat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meerkat",
        "decorations": false,
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "url": "index.html"
      },
      {
        "label": "panel",
        "title": "Meerkat Panel",
        "width": 400,
        "height": 580,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "url": "panel.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TZZ",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
